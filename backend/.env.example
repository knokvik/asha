# Copy to .env locally or set these values in the hosting provider's secret store.
# Never commit a real password, token, or SECRET_KEY.
ENVIRONMENT=production
DEBUG=false
DATABASE_URL=postgresql+asyncpg://postgres:URL_ENCODED_PASSWORD@db.ovrlderrhlrgyhexwwny.supabase.co:5432/postgres
DATABASE_SSL_REQUIRE=true
SECRET_KEY=replace-with-a-long-random-production-secret
ALLOWED_ORIGINS=["https://your-dashboard.example.com"]

# Required by the sync/notification workers when enabled.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
