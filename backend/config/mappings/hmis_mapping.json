    "M2.9": {
      "category": "Child Health and Immunization",
      "name": "Number of infants given OPV-0 dose at birth",
      "source_encounters": ["IMMUNIZATION_DOSE"],
      "observation_code": "VACCINE_CODE",
      "expected_value": "OPV_0"
