    "M2.15": {
      "category": "Child Health and Immunization",
      "name": "Infant deaths reported (under 1 year)",
      "source_encounters": ["INFANT_DEATH_REPORT"],
      "observation_code": "EVENT_TYPE",
      "expected_value": "INFANT_DEATH"
    },

