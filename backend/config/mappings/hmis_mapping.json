{
  "system": "HMIS",
  "version": "2026.1",
  "state_code": "default",
  "description": "Ministry of Health and Family Welfare (MoHFW) National HMIS Monthly Facility/Subcentre Indicators",
  "indicators": {
    "M1.1": {
      "category": "Maternal Health",
      "name": "Total number of pregnant women registered for ANC within 1st trimester",
      "source_encounters": ["ANC_REGISTRATION"],
      "filter_field": "trimester",
      "filter_value": 1
    },
    "M1.2": {
      "category": "Maternal Health",
      "name": "Total number of pregnant women registered for ANC after 1st trimester",
      "source_encounters": ["ANC_REGISTRATION"],
      "filter_field": "trimester_gt",
      "filter_value": 1
    },
    "M1.3": {
      "category": "Maternal Health",
      "name": "Number of pregnant women given 180 Iron Folic Acid (IFA) tablets",
      "source_encounters": ["ANC_VISIT"],
      "observation_code": "IFA_TABLETS_GIVEN",
      "min_value": 180
    },
    "M1.4": {
      "category": "Maternal Health",
      "name": "Number of pregnant women received 4 or more ANC check-ups",
      "source_encounters": ["ANC_VISIT"],
      "min_visit_count": 4
    },
    "M1.5": {
      "category": "Maternal Health",
      "name": "Number of pregnant women tested for Hemoglobin (Hb < 7 g/dL, severe anemia)",
      "source_encounters": ["ANC_VISIT", "LAB_TEST"],
      "observation_code": "HAEMOGLOBIN",
      "max_value": 7.0
    },
    "M1.6": {
      "category": "Maternal Health",
      "name": "Number of pregnant women with severe anemia treated at facility",
      "source_encounters": ["ANC_VISIT", "REFERRAL_FOLLOWUP"],
      "observation_code": "SEVERE_ANEMIA_TREATED",
      "expected_value": "YES"
    },
    "M1.7": {
      "category": "Maternal Health",
      "name": "Total institutional deliveries conducted (Public facilities)",
      "source_encounters": ["DELIVERY"],
      "observation_code": "DELIVERY_PLACE_TYPE",
      "expected_value": "PUBLIC"
    },
    "M1.8": {
      "category": "Maternal Health",
      "name": "Total institutional deliveries conducted (Private facilities)",
      "source_encounters": ["DELIVERY"],
      "observation_code": "DELIVERY_PLACE_TYPE",
      "expected_value": "PRIVATE"
    },
    "M1.9": {
      "category": "Maternal Health",
      "name": "Total home deliveries attended by Skilled Birth Attendant (SBA)",
      "source_encounters": ["DELIVERY"],
      "observation_code": "DELIVERY_ATTENDANT",
      "expected_value": "SBA"
    },
    "M1.10": {
      "category": "Maternal Health",
      "name": "Total home deliveries attended by Non-SBA",
      "source_encounters": ["DELIVERY"],
      "observation_code": "DELIVERY_ATTENDANT",
      "expected_value": "NON_SBA"
    },
    "M1.11": {
      "category": "Maternal Health",
      "name": "Maternal deaths reported during pregnancy, delivery, or within 42 days",
      "source_encounters": ["MATERNAL_DEATH_REPORT"],
      "observation_code": "EVENT_TYPE",
      "expected_value": "MATERNAL_DEATH"
    },
    "M1.12": {
      "category": "Maternal Health",
      "name": "Number of High Risk Pregnancies (HRP) identified and tracked",
      "source_encounters": ["ANC_VISIT", "HRP_IDENTIFIED"],
      "observation_code": "HRP_STATUS",
      "expected_value": "HIGH_RISK"
    },

    "M2.1": {
      "category": "Child Health and Immunization",
      "name": "Total number of live births - Male",
      "source_encounters": ["NEWBORN_REGISTRATION", "DELIVERY"],
      "observation_code": "SEX",
      "expected_value": "MALE"
    },
    "M2.2": {
      "category": "Child Health and Immunization",
      "name": "Total number of live births - Female",
      "source_encounters": ["NEWBORN_REGISTRATION", "DELIVERY"],
      "observation_code": "SEX",
      "expected_value": "FEMALE"
    },
    "M2.3": {
      "category": "Child Health and Immunization",
      "name": "Total number of still births reported",
