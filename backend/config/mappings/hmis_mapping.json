      "expected_value": "STILL_BIRTH"
    },
    "M2.4": {
      "category": "Child Health and Immunization",
      "name": "Newborns weighed at birth with birth weight less than 2.5 kg (LBW)",
      "source_encounters": ["NEWBORN_REGISTRATION", "HBNC_VISIT"],
      "observation_code": "BIRTH_WEIGHT_KG",
      "max_value": 2.5
