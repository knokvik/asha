    "M2.10": {
      "category": "Child Health and Immunization",
      "name": "Number of infants given Hepatitis B birth dose",
      "source_encounters": ["IMMUNIZATION_DOSE"],
      "observation_code": "VACCINE_CODE",
      "expected_value": "HEP_B_0"
    },
    "M2.11": {
      "category": "Child Health and Immunization",
      "name": "Number of infants given Pentavalent-1 / Pentavalent-3 dose",
      "source_encounters": ["IMMUNIZATION_DOSE"],
      "observation_code": "VACCINE_CODE",
      "expected_values": ["PENTA_1", "PENTA_2", "PENTA_3"]
