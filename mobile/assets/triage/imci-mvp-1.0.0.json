{
  "ruleset_id": "imci-mvp",
  "ruleset_version": "imci-mvp-1.0.0",
  "source_note": "Drafted from WHO IMCI chart booklet concepts for children 2 months to 5 years. Requires qualified clinical review before field use.",
  "clinical_signoff": {"reviewer": null, "date": null, "status": "PENDING"},
  "rules": [
    {"id":"DS-01","category":"GENERAL_DANGER_SIGN","severity":"RED","requires":["danger_signs.unable_to_drink_or_breastfeed"],"when":{"field":"danger_signs.unable_to_drink_or_breastfeed","op":"eq","value":"YES"},"reason_key":"reason.unable_to_drink","reason_text":{"en":"Unable to drink or breastfeed.","hi":"बच्चा पानी या स्तनपान नहीं कर पा रहा है।","mr":"मुलाला पाणी किंवा स्तनपान करता येत नाही."},"advice_key":"advice.red.urgent_referral","evidence_fields":["danger_signs.unable_to_drink_or_breastfeed"],"source_ref":"WHO-IMCI/general-danger-signs"},
    {"id":"DS-02","category":"GENERAL_DANGER_SIGN","severity":"RED","requires":["danger_signs.vomits_everything"],"when":{"field":"danger_signs.vomits_everything","op":"eq","value":"YES"},"reason_key":"reason.vomits_everything","reason_text":{"en":"Child vomits everything.","hi":"बच्चा सब कुछ उल्टी कर देता है।","mr":"मुलाला सगळ्या गोष्टींची उलटी होते."},"advice_key":"advice.red.urgent_referral","evidence_fields":["danger_signs.vomits_everything"],"source_ref":"WHO-IMCI/general-danger-signs"},
    {"id":"DS-03","category":"GENERAL_DANGER_SIGN","severity":"RED","requires":["danger_signs.convulsions_this_illness"],"when":{"field":"danger_signs.convulsions_this_illness","op":"eq","value":"YES"},"reason_key":"reason.convulsions","reason_text":{"en":"Convulsions occurred during this illness.","hi":"इस बीमारी के दौरान ऐंठन हुई है।","mr":"या आजारात आकडी आली आहे."},"advice_key":"advice.red.urgent_referral","evidence_fields":["danger_signs.convulsions_this_illness"],"source_ref":"WHO-IMCI/general-danger-signs"},
    {"id":"DS-04","category":"GENERAL_DANGER_SIGN","severity":"RED","requires":["danger_signs.convulsing_now"],"when":{"field":"danger_signs.convulsing_now","op":"eq","value":"YES"},"reason_key":"reason.convulsing_now","reason_text":{"en":"Child is convulsing now.","hi":"बच्चे को अभी ऐंठन हो रही है।","mr":"मुलाला आत्ता आकडी येत आहे."},"advice_key":"advice.red.urgent_referral","evidence_fields":["danger_signs.convulsing_now"],"source_ref":"WHO-IMCI/general-danger-signs"},
    {"id":"DS-05","category":"GENERAL_DANGER_SIGN","severity":"RED","requires":["danger_signs.lethargic_or_unconscious"],"when":{"field":"danger_signs.lethargic_or_unconscious","op":"eq","value":"YES"},"reason_key":"reason.lethargic","reason_text":{"en":"Child is lethargic or unconscious.","hi":"बच्चा बहुत सुस्त या बेहोश है।","mr":"मूल खूप सुस्त किंवा बेशुद्ध आहे."},"advice_key":"advice.red.urgent_referral","evidence_fields":["danger_signs.lethargic_or_unconscious"],"source_ref":"WHO-IMCI/general-danger-signs"},
    {"id":"RESP-01","category":"COUGH_BREATHING","severity":"RED","requires":["observations.chest_indrawing"],"when":{"field":"observations.chest_indrawing","op":"eq","value":"YES"},"reason_key":"reason.chest_indrawing","reason_text":{"en":"Chest indrawing is present.","hi":"सांस लेते समय छाती अंदर धंसती है।","mr":"श्वास घेताना छाती आत ओढली जाते."},"advice_key":"advice.red.urgent_referral","evidence_fields":["observations.chest_indrawing"],"source_ref":"WHO-IMCI/cough-difficult-breathing"},
    {"id":"RESP-02","category":"COUGH_BREATHING","severity":"RED","requires":["symptoms.cough","vitals.respiratory_rate","patient.age_months"],"when":{"all":[{"field":"symptoms.cough","op":"eq","value":"YES"},{"field":"vitals.respiratory_rate","op":"gte","threshold_table":{"key_field":"patient.age_months","bands":[{"min":2,"max":11,"value":50},{"min":12,"max":59,"value":40}]}}]},"reason_key":"reason.fast_breathing","reason_text":{"en":"Fast breathing for age: {vitals.respiratory_rate}/min.","hi":"उम्र के अनुसार तेज सांस: {vitals.respiratory_rate}/मिनट।","mr":"वयानुसार जलद श्वास: {vitals.respiratory_rate}/मिनिट."},"advice_key":"advice.red.urgent_referral","evidence_fields":["vitals.respiratory_rate","patient.age_months"],"source_ref":"WHO-IMCI/cough-difficult-breathing"},
    {"id":"RESP-03","category":"COUGH_BREATHING","severity":"RED","requires":["observations.stridor_when_calm"],"when":{"field":"observations.stridor_when_calm","op":"eq","value":"YES"},"reason_key":"reason.stridor","reason_text":{"en":"Stridor is present when the child is calm.","hi":"बच्चा शांत होने पर भी खुरदरी सांस की आवाज है।","mr":"मूल शांत असतानाही श्वासाला घरघर आवाज आहे."},"advice_key":"advice.red.urgent_referral","evidence_fields":["observations.stridor_when_calm"],"source_ref":"WHO-IMCI/cough-difficult-breathing"},
    {"id":"RESP-04","category":"COUGH_BREATHING","severity":"RED","requires":["observations.grunting","observations.nasal_flaring","observations.severe_respiratory_distress"],"when":{"any":[{"field":"observations.grunting","op":"eq","value":"YES"},{"field":"observations.nasal_flaring","op":"eq","value":"YES"},{"field":"observations.severe_respiratory_distress","op":"eq","value":"YES"}]},"reason_key":"reason.severe_respiratory_distress","reason_text":{"en":"A severe breathing effort sign is present.","hi":"सांस लेने में गंभीर परेशानी का संकेत है।","mr":"श्वास घेण्यास गंभीर त्रासाचे चिन्ह आहे."},"advice_key":"advice.red.urgent_referral","evidence_fields":["observations.grunting","observations.nasal_flaring","observations.severe_respiratory_distress"],"source_ref":"WHO-IMCI/cough-difficult-breathing"},
    {"id":"RESP-05","category":"COUGH_BREATHING","severity":"YELLOW","requires":["symptoms.cough","symptoms.cough_duration_days"],"when":{"all":[{"field":"symptoms.cough","op":"eq","value":"YES"},{"field":"symptoms.cough_duration_days","op":"gte","value":14}]},"reason_key":"reason.long_cough","reason_text":{"en":"Cough has lasted 14 days or more.","hi":"खांसी 14 दिन या अधिक से है।","mr":"खोकला १४ दिवस किंवा अधिक काळापासून आहे."},"advice_key":"advice.yellow.prompt_phc","evidence_fields":["symptoms.cough_duration_days"],"source_ref":"WHO-IMCI/cough-difficult-breathing"},
{"id":"RESP-06","category":"COUGH_BREATHING","severity":"GREEN","requires":["symptoms.cough","vitals.respiratory_rate","patient.age_months","observations.chest_indrawing","observations.stridor_when_calm"],"when":{"all":[{"field":"symptoms.cough","op":"eq","value":"YES"},{"field":"observations.chest_indrawing","op":"eq","value":"NO"},{"field":"observations.stridor_when_calm","op":"eq","value":"NO"},{"field":"vitals.respiratory_rate","op":"lt","threshold_table":{"key_field":"patient.age_months","bands":[{"min":2,"max":11,"value":50},{"min":12,"max":59,"value":40}]}}]},"reason_key":"reason.cough_no_red_sign","reason_text":{"en":"Cough is recorded without a flagged breathing sign.","hi":"खांसी दर्ज है लेकिन सांस का कोई चिन्ह नहीं मिला।","mr":"खोकला आहे, पण श्वासाचे धोक्याचे चिन्ह आढळले नाही."},"advice_key":"advice.green.routine_followup","evidence_fields":["symptoms.cough"],"source_ref":"WHO-IMCI/cough-difficult-breathing"},
    {"id":"DIA-01","category":"DIARRHOEA_DEHYDRATION","severity":"RED","requires":["symptoms.diarrhoea","observations.lethargic_or_unconscious","observations.sunken_eyes","observations.drinking_pattern","observations.skin_pinch"],"when":{"all":[{"field":"symptoms.diarrhoea","op":"eq","value":"YES"},{"field":"__count__","op":"count_true_at_least","value":2,"conditions":[{"field":"observations.lethargic_or_unconscious","op":"eq","value":"YES"},{"field":"observations.sunken_eyes","op":"eq","value":"YES"},{"field":"observations.drinking_pattern","op":"in","value":["POOR_OR_UNABLE"]},{"field":"observations.skin_pinch","op":"eq","value":"VERY_SLOW"}]}]},"reason_key":"reason.severe_dehydration","reason_text":{"en":"Two or more severe dehydration signs are present.","hi":"गंभीर निर्जलीकरण के दो या अधिक संकेत हैं।","mr":"गंभीर निर्जलीकरणाची दोन किंवा अधिक चिन्हे आहेत."},"advice_key":"advice.red.urgent_referral","evidence_fields":["observations.lethargic_or_unconscious","observations.sunken_eyes","observations.drinking_pattern","observations.skin_pinch"],"source_ref":"WHO-IMCI/diarrhoea-dehydration"},
    {"id":"DIA-02","category":"DIARRHOEA_DEHYDRATION","severity":"YELLOW","requires":["symptoms.diarrhoea","observations.restless_irritable","observations.sunken_eyes","observations.drinking_pattern","observations.skin_pinch"],"when":{"all":[{"field":"symptoms.diarrhoea","op":"eq","value":"YES"},{"field":"__count__","op":"count_true_at_least","value":2,"conditions":[{"field":"observations.restless_irritable","op":"eq","value":"YES"},{"field":"observations.sunken_eyes","op":"eq","value":"YES"},{"field":"observations.drinking_pattern","op":"eq","value":"EAGER_THIRSTY"},{"field":"observations.skin_pinch","op":"eq","value":"SLOW"}]}]},"reason_key":"reason.some_dehydration","reason_text":{"en":"Two or more signs of some dehydration are present.","hi":"कुछ निर्जलीकरण के दो या अधिक संकेत हैं।","mr":"काही निर्जलीकरणाची दोन किंवा अधिक चिन्हे आहेत."},"advice_key":"advice.yellow.prompt_phc","evidence_fields":["observations.restless_irritable","observations.sunken_eyes","observations.drinking_pattern","observations.skin_pinch"],"source_ref":"WHO-IMCI/diarrhoea-dehydration"},
    {"id":"DIA-03","category":"DIARRHOEA_DEHYDRATION","severity":"YELLOW","requires":["symptoms.diarrhoea","symptoms.blood_in_stool"],"when":{"all":[{"field":"symptoms.diarrhoea","op":"eq","value":"YES"},{"field":"symptoms.blood_in_stool","op":"eq","value":"YES"}]},"reason_key":"reason.blood_in_stool","reason_text":{"en":"Blood is reported in the stool.","hi":"मल में खून बताया गया है।","mr":"शौचात रक्त दिसत आहे."},"advice_key":"advice.yellow.prompt_phc","evidence_fields":["symptoms.blood_in_stool"],"source_ref":"WHO-IMCI/diarrhoea-dehydration"},
    {"id":"DIA-04","category":"DIARRHOEA_DEHYDRATION","severity":"YELLOW","requires":["symptoms.diarrhoea","symptoms.diarrhoea_duration_days"],"when":{"all":[{"field":"symptoms.diarrhoea","op":"eq","value":"YES"},{"field":"symptoms.diarrhoea_duration_days","op":"gte","value":14}]},"reason_key":"reason.long_diarrhoea","reason_text":{"en":"Diarrhoea has lasted 14 days or more.","hi":"दस्त 14 दिन या अधिक से हैं।","mr":"जुलाब १४ दिवस किंवा अधिक काळापासून आहेत."},"advice_key":"advice.yellow.prompt_phc","evidence_fields":["symptoms.diarrhoea_duration_days"],"source_ref":"WHO-IMCI/diarrhoea-dehydration"},
    {"id":"DIA-05","category":"DIARRHOEA_DEHYDRATION","severity":"GREEN","requires":["symptoms.diarrhoea","observations.restless_irritable","observations.sunken_eyes","observations.drinking_pattern","observations.skin_pinch"],"when":{"all":[{"field":"symptoms.diarrhoea","op":"eq","value":"YES"},{"field":"observations.restless_irritable","op":"eq","value":"NO"},{"field":"observations.sunken_eyes","op":"eq","value":"NO"},{"field":"observations.drinking_pattern","op":"eq","value":"NORMAL"},{"field":"observations.skin_pinch","op":"eq","value":"NORMAL"}]},"reason_key":"reason.diarrhoea_no_dehydration","reason_text":{"en":"Diarrhoea is recorded without dehydration signs.","hi":"दस्त दर्ज हैं लेकिन निर्जलीकरण के संकेत नहीं हैं।","mr":"जुलाब आहेत, पण निर्जलीकरणाची चिन्हे नाहीत."},"advice_key":"advice.green.routine_followup","evidence_fields":["symptoms.diarrhoea"],"source_ref":"WHO-IMCI/diarrhoea-dehydration"},
    {"id":"FEV-01","category":"FEVER","severity":"RED","requires":["symptoms.fever","observations.stiff_neck"],"when":{"all":[{"field":"symptoms.fever","op":"eq","value":"YES"},{"field":"observations.stiff_neck","op":"eq","value":"YES"}]},"reason_key":"reason.stiff_neck","reason_text":{"en":"Fever with a stiff neck is recorded.","hi":"बुखार के साथ गर्दन अकड़ी हुई है।","mr":"तापासोबत मान ताठ आहे."},"advice_key":"advice.red.urgent_referral","evidence_fields":["observations.stiff_neck"],"source_ref":"WHO-IMCI/fever"},
    {"id":"FEV-02","category":"FEVER","severity":"RED","requires":["symptoms.fever","vitals.temperature_c","patient.age_months"],"when":{"all":[{"field":"symptoms.fever","op":"eq","value":"YES"},{"field":"vitals.temperature_c","op":"gte","value":38.5},{"field":"patient.age_months","op":"lte","value":3}]},"reason_key":"reason.young_infant_fever","reason_text":{"en":"Temperature is high in a 2–3 month-old infant.","hi":"2–3 महीने के शिशु में तापमान अधिक है।","mr":"२–३ महिन्यांच्या बाळाचे तापमान जास्त आहे."},"advice_key":"advice.red.urgent_referral","evidence_fields":["vitals.temperature_c","patient.age_months"],"source_ref":"WHO-IMCI/fever"},
    {"id":"FEV-03","category":"FEVER","severity":"YELLOW","requires":["symptoms.fever","symptoms.fever_duration_days","observations.feels_hot_to_touch"],"when":{"all":[{"field":"symptoms.fever","op":"eq","value":"YES"},{"any":[{"field":"symptoms.fever_duration_days","op":"gte","value":7},{"field":"observations.feels_hot_to_touch","op":"eq","value":"YES"}]}]},"reason_key":"reason.fever_needs_phc","reason_text":{"en":"Fever needs prompt PHC review.","hi":"बुखार के लिए जल्द PHC जांच जरूरी है।","mr":"तापासाठी लवकर PHC तपासणी आवश्यक आहे."},"advice_key":"advice.yellow.prompt_phc","evidence_fields":["symptoms.fever_duration_days"],"source_ref":"WHO-IMCI/fever"},
    {"id":"FEV-04","category":"FEVER","severity":"YELLOW","requires":["symptoms.fever","symptoms.cough","symptoms.diarrhoea"],"when":{"all":[{"field":"symptoms.fever","op":"eq","value":"YES"},{"any":[{"field":"symptoms.cough","op":"eq","value":"YES"},{"field":"symptoms.diarrhoea","op":"eq","value":"YES"}]}]},"reason_key":"reason.fever_with_other_finding","reason_text":{"en":"Fever is present with another respiratory or diarrhoea finding.","hi":"बुखार के साथ सांस या दस्त का एक और संकेत है।","mr":"तापासोबत श्वास किंवा जुलाबाचे आणखी एक लक्षण आहे."},"advice_key":"advice.yellow.prompt_phc","evidence_fields":["symptoms.fever","symptoms.cough","symptoms.diarrhoea"],"source_ref":"WHO-IMCI/fever"},
    {"id":"FEV-05","category":"FEVER","severity":"GREEN","requires":["symptoms.fever","symptoms.fever_duration_days","observations.stiff_neck"],"when":{"all":[{"field":"symptoms.fever","op":"eq","value":"YES"},{"field":"symptoms.fever_duration_days","op":"lt","value":7},{"field":"observations.stiff_neck","op":"eq","value":"NO"}]},"reason_key":"reason.short_fever","reason_text":{"en":"Short-duration fever without a recorded danger sign.","hi":"कम अवधि का बुखार और कोई दर्ज खतरे का संकेत नहीं।","mr":"कमी कालावधीचा ताप आणि धोक्याचे चिन्ह नाही."},"advice_key":"advice.green.routine_followup","evidence_fields":["symptoms.fever_duration_days"],"source_ref":"WHO-IMCI/fever"},
    {"id":"NUT-01","category":"NUTRITION","severity":"RED","requires":["observations.oedema_both_feet"],"when":{"field":"observations.oedema_both_feet","op":"eq","value":"YES"},"reason_key":"reason.oedema","reason_text":{"en":"Oedema of both feet is present.","hi":"दोनों पैरों में सूजन है।","mr":"दोन्ही पायांना सूज आहे."},"advice_key":"advice.red.urgent_referral","evidence_fields":["observations.oedema_both_feet"],"source_ref":"WHO-IMCI/nutrition"},
    {"id":"NUT-02","category":"NUTRITION","severity":"RED","requires":["vitals.muac_mm"],"when":{"field":"vitals.muac_mm","op":"lt","value":115},"reason_key":"reason.low_muac_red","reason_text":{"en":"MUAC is below 115 mm.","hi":"MUAC 115 mm से कम है।","mr":"MUAC ११५ मिमीपेक्षा कमी आहे."},"advice_key":"advice.red.urgent_referral","evidence_fields":["vitals.muac_mm"],"source_ref":"WHO-IMCI/nutrition"},
    {"id":"NUT-03","category":"NUTRITION","severity":"RED","requires":["observations.visible_severe_wasting"],"when":{"field":"observations.visible_severe_wasting","op":"eq","value":"YES"},"reason_key":"reason.severe_wasting","reason_text":{"en":"Visible severe wasting is present.","hi":"गंभीर दुबलापन दिखाई दे रहा है।","mr":"दृश्यमान गंभीर कृशता आहे."},"advice_key":"advice.red.urgent_referral","evidence_fields":["observations.visible_severe_wasting"],"source_ref":"WHO-IMCI/nutrition"},
    {"id":"NUT-04","category":"NUTRITION","severity":"YELLOW","requires":["vitals.muac_mm"],"when":{"all":[{"field":"vitals.muac_mm","op":"gte","value":115},{"field":"vitals.muac_mm","op":"lt","value":125}]},"reason_key":"reason.low_muac_yellow","reason_text":{"en":"MUAC is in the 115–124 mm screening range.","hi":"MUAC 115–124 mm की जांच सीमा में है।","mr":"MUAC ११५–१२४ मिमी तपासणी मर्यादेत आहे."},"advice_key":"advice.yellow.prompt_phc","evidence_fields":["vitals.muac_mm"],"source_ref":"WHO-IMCI/nutrition"},
    {"id":"CMP-01","category":"COMPOSITE","severity":"RED","requires":[],"when":{"all":[]},"composite":{"type":"yellow_count_at_least","threshold":3},"reason_key":"reason.multi_system_caution","reason_text":{"en":"Three or more yellow findings crossed the conservative caution threshold.","hi":"तीन या अधिक पीले संकेतों से सावधानी की सीमा पार हुई है।","mr":"तीन किंवा अधिक पिवळ्या निष्कर्षांमुळे सावधगिरीची मर्यादा ओलांडली आहे."},"advice_key":"advice.red.urgent_referral","evidence_fields":[],"source_ref":"PROJECT-POLICY/asymmetric-cost"},
    {"id":"CMP-03","category":"COMPOSITE","severity":"RED","requires":[],"when":{"all":[]},"composite":{"type":"followup_red_not_improved","threshold":1},"reason_key":"reason.red_followup_not_improved","reason_text":{"en":"A previous RED assessment is followed by symptoms that have not improved.","hi":"पिछली लाल जांच के बाद लक्षणों में सुधार नहीं हुआ है।","mr":"मागील लाल तपासणीनंतर लक्षणांमध्ये सुधारणा झालेली नाही."},"advice_key":"advice.red.urgent_referral","evidence_fields":[],"source_ref":"PROJECT-POLICY/follow-up-escalation"}
  ]
}
